<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settingsToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/settings"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- ОФОРМЛЕНИЕ -->
            <TextView
                style="@style/TextAppearance.MokoFile.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_appearance" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:id="@+id/rowTheme"
                        style="@style/Widget.MokoFile.SettingRow">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_palette" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingTitle"
                                android:text="@string/theme" />

                            <TextView
                                android:id="@+id/themeValue"
                                style="@style/TextAppearance.MokoFile.SettingSubtitle" />
                        </LinearLayout>

                        <ImageView
                            style="@style/Widget.MokoFile.SettingChevron" />
                    </LinearLayout>

                    <View style="@style/Widget.MokoFile.SettingDivider" />

                    <LinearLayout
                        android:id="@+id/rowDynamic"
                        style="@style/Widget.MokoFile.SettingRow">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_star" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingTitle"
                                android:text="@string/dynamic_color" />

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingSubtitle"
                                android:text="@string/dynamic_color_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swDynamic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false" />
                    </LinearLayout>

                    <View style="@style/Widget.MokoFile.SettingDivider" />

                    <LinearLayout
                        android:id="@+id/rowView"
                        style="@style/Widget.MokoFile.SettingRow">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_grid" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingTitle"
                                android:text="@string/default_view" />

                            <TextView
                                android:id="@+id/viewValue"
                                style="@style/TextAppearance.MokoFile.SettingSubtitle" />
                        </LinearLayout>

                        <ImageView
                            style="@style/Widget.MokoFile.SettingChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ФАЙЛЫ -->
            <TextView
                style="@style/TextAppearance.MokoFile.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_files" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:id="@+id/rowHidden"
                        style="@style/Widget.MokoFile.SettingRow">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_folder_open" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingTitle"
                                android:text="@string/hidden_files" />

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingSubtitle"
                                android:text="@string/hidden_files_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swHidden"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false" />
                    </LinearLayout>

                    <View style="@style/Widget.MokoFile.SettingDivider" />

                    <LinearLayout
                        android:id="@+id/rowFolders"
                        style="@style/Widget.MokoFile.SettingRow">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_folder" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingTitle"
                                android:text="@string/folders_first" />

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingSubtitle"
                                android:text="@string/folders_first_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swFolders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false" />
                    </LinearLayout>

                    <View style="@style/Widget.MokoFile.SettingDivider" />

                    <LinearLayout
                        android:id="@+id/rowConfirm"
                        style="@style/Widget.MokoFile.SettingRow">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_delete" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingTitle"
                                android:text="@string/confirm_delete" />

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingSubtitle"
                                android:text="@string/confirm_delete_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swConfirm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ХРАНИЛИЩЕ -->
            <TextView
                style="@style/TextAppearance.MokoFile.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_storage" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/storage_title"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/storageValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/storageBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="?attr/colorSurface"
                        app:trackCornerRadius="8dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/storageUsed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/storageFree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.MokoFile.SettingDivider"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:id="@+id/rowAccess"
                        style="@style/Widget.MokoFile.SettingRow"
                        android:paddingHorizontal="0dp">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_info" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingTitle"
                                android:text="@string/access_all_files" />

                            <TextView
                                android:id="@+id/accessStatus"
                                style="@style/TextAppearance.MokoFile.SettingSubtitle" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/accessButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="@string/open" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- О ПРИЛОЖЕНИИ -->
            <TextView
                style="@style/TextAppearance.MokoFile.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_about" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        style="@style/Widget.MokoFile.SettingRow"
                        android:clickable="false"
                        android:focusable="false">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_info" />

                        <TextView
                            style="@style/TextAppearance.MokoFile.SettingTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/version" />

                        <TextView
                            android:id="@+id/versionValue"
                            style="@style/TextAppearance.MokoFile.SettingSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp" />
                    </LinearLayout>

                    <View style="@style/Widget.MokoFile.SettingDivider" />

                    <LinearLayout
                        android:id="@+id/rowRepo"
                        style="@style/Widget.MokoFile.SettingRow">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_star" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingTitle"
                                android:text="@string/repository" />

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingSubtitle"
                                android:text="@string/repository_desc" />
                        </LinearLayout>

                        <ImageView
                            style="@style/Widget.MokoFile.SettingChevron" />
                    </LinearLayout>

                    <View style="@style/Widget.MokoFile.SettingDivider" />

                    <LinearLayout
                        android:id="@+id/rowReset"
                        style="@style/Widget.MokoFile.SettingRow">

                        <ImageView
                            style="@style/Widget.MokoFile.SettingIcon"
                            android:src="@drawable/ic_refresh" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingTitle"
                                android:text="@string/reset_settings"
                                android:textColor="?attr/colorError" />

                            <TextView
                                style="@style/TextAppearance.MokoFile.SettingSubtitle"
                                android:text="@string/reset_settings_desc" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/about_note"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
